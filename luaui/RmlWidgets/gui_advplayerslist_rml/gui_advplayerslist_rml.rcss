/* gui_advplayerslist_rml — Advanced Player List v1 (display + collapse)
   Bottom-right anchored vertical panel (matches the FlowUI original's corner).

   Styling is utility-class / CCG ONLY (palette + rml-utility-classes). This
   sheet carries only the LAYOUT GEOMETRY utilities can't express: the screen
   anchor, the name nowrap, the collapse animation, the disclosure caret, and
   the master-toggle pennant.

   NOTE: no scroll in v1. Short lists; the panel grows to fit its contents.
   Re-add an overflow container with a max-height when player counts exceed ~10. */

#gui_advplayerslist_rml-widget {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 200dp;
    display: block;
}

#widget-container {
    display: block;
    position: relative;   /* offset parent for the absolute share overlay (does
                             NOT affect the rail handle, whose offset parent is the
                             nearer relative .rail div) */
}

/* Player name: keep it on ONE line (no 2-line wrap). white-space:nowrap is SAFE
   for text here (gui_options_rml / gui_tech_points use it); only overflow:hidden
   vanishes glyphs in this build — so we DON'T clip. Paired with min-w-0 in the
   class list so the flex item shrinks to its slot rather than pushing the eco
   bars off the panel. Long names may spill slightly (accepted residual). */
.pname {
    white-space: nowrap;
}

/* ── Collapse animation ───────────────────────────────────────────────────
   A player row's open height comes from the h-4 utility (16dp). When its
   section closes, the .row-collapsed class (appended via data-attr-class) drives
   height + opacity to 0; .prow's transition animates the change. overflow:hidden
   clips the content as it shrinks (non-text container → safe). row-collapsed
   loads AFTER the h-4 utility to win the height (widget sheet is linked last). */
.prow {
    transition: height 0.13s quadratic-out, opacity 0.13s quadratic-out;
    overflow: hidden;
}
.row-collapsed {
    height: 0dp;
    opacity: 0;
}

/* Disclosure caret: ">" that rotates to point down when the section is open. */
.caret {
    width: 8dp;
    text-align: center;
    transition: transform 0.13s quadratic-out;
}
.caret-open {
    transform: rotate(90deg);
}

/* ── Master toggle — a plain click strip with a bottom fade ─────────────────
   The rail (my.rail = relative w-3-5) is a transparent 14dp flex column that
   stretches to the full list height. The HANDLE fills it (inset 0), has NO
   background, and is the only click target (onToggleAll). Its single child
   .rail-fade sits at the BOTTOM with the bg-gradient utility (transparent→dark).
   Opening grows the fade taller for a touch of feedback. Tune: the two heights. */
.rail-handle {
    position: absolute;
    left: 0;
    right: 0;                      /* fills the 14dp rail column */
    top: 10%;                      /* closed: flag starts near the top; .rail-open → 50% */
    bottom: 0;                     /* fills DOWN to the bottom → the bottom portion */
    clip: always;                  /* trims the oversized wedge to the handle box */
    cursor: pointer;
    transition: top 0.13s quadratic-out;
}
.rail-handle.rail-open {
    top: 50%;                      /* open: rises to ~50% */
}

/* The wedge fill: a BIG square rotated 60° whose top corner sits at the panel edge
   on the %-line and fills solidly down; the handle clips it to a flag with a 30°
   top edge. left/top pin the corner. KEEP IT OVERSIZED — that's what makes it a
   flag, not a chevron. */
.rail-wedge {
    position: absolute;
    left: -123dp;
    top: 37dp;
    width: 200dp;
    height: 200dp;
    transform: rotate(60deg);
}

/* CHEEKY gradient: a separate transparent→dark overlay covering the BOTTOM HALF of
   the rail, on TOP of the solid wedge, so the fade reads. pe-none → clicks fall
   through to the handle. */
.rail-gradient {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;                      /* bottom half of the rail */
    bottom: 0;
}

/* Eco-bar hit target: a transparent handle, full row height (16dp) for an easy grab,
   with the thin gray TRACK centred inside (flex items-center). Metal + energy sit SIDE
   BY SIDE. The picker OPENS on mousedown (pops the instant you press) but the GESTURE is
   the RmlUi drag (dragstart capture is reliable; we track via the cursor and FINISH on
   dragend OR mouseup — never by polling the button, which RmlUi's capture makes lie).
   `drag: drag` is required for the drag/dragend events. */
.share-hit {
    width: 30dp;
    height: 16dp;
    drag: drag;
}
/* The bar TRACK: a thin gray bar (gray bg + w-full via utilities in the .rml). */
.share-bar {
    height: 5dp;
    position: relative;     /* anchor for the absolute fill */
    transition: transform 0.1s quadratic-out;
}
/* HOVER JUICE on the eco bars — the track fattens (and the fill with it) when the
   cursor is over its hit target, so it's clear you're about to grab/drag it. :hover
   propagates from the bar up to .share-hit, so hovering anywhere in the grab area counts. */
.share-hit:hover .share-bar {
    transform: scaleY(1.8);
}
/* The FILL: grows from the LEFT to data-style-width = current %, full track height;
   colour (metal light / energy warning) via utility in the .rml. */
.share-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    display: block;
}

/* ── Share popup ────────────────────────────────────────────────────────────
   A COMPACT box that floats ABOVE the dragged bar. Absolute child of #list-panel;
   left/top are set per-drag from the model (popupLeft/popupTop, context px = the
   bar's centre-x / top). The negative margins do the rest WITHOUT needing the dp
   ratio in Lua: margin-left:-half-width centres it on the bar; margin-top lifts it
   fully above (popup height + a small gap), so its bottom sits just over the bar.

   SHOWN/HIDDEN BY data-if="sharing" → display:none when idle. We deliberately do
   NOT gate visibility with opacity: in RmlUi opacity is INHERITED and a child's
   own opacity OVERRIDES the inherited value (NOT composite/multiply like CSS), so
   .share-dim (0.22 on the inactive control) would punch through an opacity:0 parent
   and the chips would show permanently — display:none removes the whole subtree.
   pe-none — the gesture is polled from Spring, never RmlUi input. */
.share-ov {
    position: absolute;
    display: block;       /* explicit so data-if has a non-none display to restore */
    box-sizing: border-box;
    width: 44dp;
    height: 76dp;
    margin-left: -22dp;   /* half of width → centres the popup on the bar's centre-x */
    margin-top: -72dp;    /* anchor is the hit-target TOP; the gray bar sits ~5.5dp into it,
                             so this lift (= -(height-4)) drops the popup bottom to ~2dp above the bar */
    padding: 2dp;
    pointer-events: none;
}

/* ENTRANCE JUICE: the popup pops in each time it opens. `.share-in` is toggled by
   `sharing` in the .rml, so (re)adding the class restarts the animation. back-out gives
   a small overshoot for the juice; transform-origin is the popup centre (default). */
.share-in {
    animation: 0.17s back-out 1 share-pop-in;
}
@keyframes share-pop-in {
    0%   { transform: scale(0.78); }
    100% { transform: scale(1); }
}

/* "IN FLUX" pulse: a breathing border on the ACTIVE side only — the granular FILL (the
   active rail part) while the rail is aimed, and EACH preset chip while the presets are
   aimed (shown via data-if on shareZone in the .rml). Same opacity-breathe pattern as the
   order menu's armed cell — a LEAF border element so its opacity breathes independently of
   the parent's (the fill/chip keeps its own colour + ghost); width here, colour from the
   border-light utility. Absolute inset 0 frames its parent (the fill is positioned; chips
   get position: relative). pe-none so it never eats the gesture. */
.share-pulse {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1dp;
    pointer-events: none;
    animation: 1.0s sine-in-out infinite share-pulse-kf;
}
@keyframes share-pulse-kf {
    0%   { opacity: 1.0; }
    50%  { opacity: 0.3; }
    100% { opacity: 1.0; }
}

/* Readout at the top — the live amount, text only (colour via utility in the .rml). */
.share-readout {
    display: block;
    height: 13dp;
    margin-bottom: 1dp;
}

/* Controls fill the rest of the popup below the readout: granular (left, flex-1) and
   presets (right, flex-1), each a recessed dark well, with a 1px gap between so they read
   as two distinct housings (the panel colour shows in the seam). The inset (3dp sides /
   bottom, 18dp top under the readout) is the PADDING that keeps the wells off the edge. */
.share-body {
    position: absolute;
    left: 3dp;
    right: 3dp;
    top: 18dp;
    bottom: 3dp;
    gap: 1px;
}

/* LEFT control: granular slider (flex-1, bg + relative via utilities in the .rml);
   the fill grows up from the bottom (data-style-height = sharePct%). It sits FLUSH
   against the preset chips (no middle track). */
.share-gran-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: block;
}

/* RIGHT control: preset chips fill the column as 4 equal flex-1 segments with a 1px
   gap — tight, like a stepped version of the granular bar. Colour (gray vs accent)
   is per-chip in the .rml (gray unless cursor on the preset side AND filled up to it). */
.share-presets {
    gap: 1px;
}

/* SHADOWED/ghost state for unlit content — the granular FILL when the preset side is
   aimed, and any preset chip that isn't the selected level. The fills always carry the
   resource colour and just fade to this, so unlit presets are already visible (not
   popping in from nowhere) and the recessed WELLS behind them never change. Applied to
   the leaf fills ONLY, never a well/container, so there's no opacity-inheritance leak
   (the overlay itself is hidden via display/data-if — see .share-ov + the opacity note). */
.share-dim {
    opacity: 0.3;
    transition: opacity 0.08s quadratic-out;
}
