/* === Default Styles === */
/* RMLUI has no default styles and as such these styles are provided to mimic the very basic
expectations of a UI framework. While semantic HTML is not strictly followed,
these styles aim to provide a foundation of basic styling for those coming
from traditional web design. */

body {
    font-family: "Exo 2";
    font-size: 9dp;
}

div
{
	display: block;
}

p
{
	display: block;
}

button
{
	text-transform: none;
}

h1
{
	display: block;
	font-size: 2.25rem;
	font-weight: bold;
}

h2
{
	display: block;
	font-size: 2rem;
	font-weight: bold;
}

h3
{
	display: block;
	font-size: 1.5rem;
	font-weight: bold;
}

ul,ol
{
	display: block;
	padding-left: 10dp;
}

li
{
	display: block;
}

em
{
	font-style: italic;
}

strong
{
	font-weight: bold;
}

input[type="checkbox"]
{
	width: 20dp;
	height: 20dp;
	margin-right: 5dp;
}

input[type="checkbox"]:checked
{
	background-color: rgba(0, 0, 0, 100);
}

select {
	border: 1dp #444;
	flex: 1;
}

select:focus {
	border: 1dp #666;
}

/* selectvalue, selectbox, and selectarrow are RMLUI specific selectors */
select selectvalue {
	background-color: transparent;
	margin-right: 0dp;
}

select selectbox {
	border: 1dp #444;
	border-top-width: 0;
	background-color: #222e;
}

select selectarrow {
	display: none;
}

select option {
	display: block;
	padding-top: 2dp;
	padding-bottom: 2dp;
	padding-left: 5dp;
	padding-right: 5dp;
	font-size: 8dp;
}
select option:hover { background-color: #ffffff20; }

/* === Rml Core Element Defaults === */
tabset tabs
{
	display: block;
}

/* Scrollbar — neutral, subtle, theme-agnostic. Track is a nearly-invisible
   dark inset; bar is semi-transparent white that brightens on hover and
   active-drag. RCSS rgba alpha is 0-255. Works on any dark panel bg without
   per-widget overrides. Widgets that want more presence (e.g. the console's
   tinted blues) can still override on a more specific selector. */
scrollbarvertical,
scrollbarhorizontal
{
	width: 5dp;
	height: 5dp;
}

scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack
{
	background-color: rgba(0, 0, 0, 60);
	border-radius: 2dp;
}

scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar
{
	background-color: rgba(255, 255, 255, 60);
	border-radius: 2dp;
}

scrollbarvertical sliderbar:hover,
scrollbarhorizontal sliderbar:hover
{
	background-color: rgba(255, 255, 255, 130);
}

scrollbarvertical sliderbar:active,
scrollbarhorizontal sliderbar:active
{
	background-color: rgba(255, 255, 255, 180);
}

/* Hide the inc/dec step buttons at the scrollbar ends — they're ugly,
   rarely used, and take space that the bar itself should claim. */
scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec,
scrollbarhorizontal sliderarrowinc,
scrollbarhorizontal sliderarrowdec
{
	width: 0dp;
	height: 0dp;
}

.widget-shadow {
	clip: always; /* ensures child elements do not overflow rounded corners */
}

/* Style-mode: depth axis. utils.initializeRmlWidget applies exactly one
   .depth-* class to every widget body, driven by the rml_style_depth config. */
.depth-off        { box-shadow: none; }
.depth-subtle     { box-shadow: rgba(0, 0, 0, 80) 0dp 1dp 3dp 0dp; }
.depth-medium     { box-shadow: rgba(0, 0, 0, 140) 0dp 3dp 10dp 0dp; }
.depth-pronounced { box-shadow: #000a 2dp 3dp 6dp 0dp; }

/* Style-mode: border axis. utils.initializeRmlWidget applies exactly one
   .border-* class to every widget body, driven by the rml_style_border config. */
.border-off    { border: 0dp rgba(0, 0, 0, 0); }
.border-subtle { border: 1dp rgba(255, 255, 255, 50); }
.border-strong { border: 1dp rgba(255, 255, 255, 100); }

/* Style-mode: radius axis. Applied to widget body — controls the rounding
   of the widget container itself (independent of CCG panel radius). */
.radius-square  { border-radius: 0dp; }
.radius-subtle  { border-radius: 4dp; }
.radius-rounded { border-radius: 8dp; }