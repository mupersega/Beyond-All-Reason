/* rml_style_guide Widget Styles */
#rml_style_guide-widget {
    /* positional properties */
    display: flex;
    position: absolute;
    left: 50dp;
    top: 50%;
    transform: translateY(-50%);
    /* dimensional properties */
    width: 900dp;
    height: 80vh;
}

#widget-container {
    display: flex;
    flex-direction: column;
    flex: 1;
}

/* Small floating debug controls */
.debug-controls {
    position: absolute;
    top: -3dp;
    right: -3dp;
    display: flex;
    gap: 3dp;
    z-index: 10;
}

.debug-btn {
    height: 20dp;
    padding: 0 4dp;
    cursor: pointer;
    text-align: center;
    line-height: 18dp;
    transition: all 0.1s;
}

.debug-btn:hover {
    transform: scale(1.1);
}

.debug-btn:active {
    transform: scale(0.95);
}

.code-green {
    color: #2cfd79;
}

/* Draggable handle styles */
.handle {
    height: 100%;
    cursor: move;
    text-align: left;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 5;
    border-top-left-radius: 10dp;
    border-top-right-radius: 10dp;
    clip: always;
}

.handle>.greeble {
    color: #00000000;
    padding-left: 5dp;
    position: relative;
    top: -28dp;
    font-size: 2.5rem;
}

@keyframes greeble-pulse {
    0% { color: #00000000; }
    50% { color: #fad400; }
    100% { color: #00000000;  }
}

@keyframes jiggle-on-x {
    0% { transform: translateX(0dp) rotate(45deg); }
    25% { transform: translateX(-2dp) rotate(45deg); }
    50% { transform: translateX(2dp) rotate(45deg); }
    75% { transform: translateX(-2dp) rotate(45deg); }
    100% { transform: translateX(0dp) rotate(45deg); }
}

.handle:hover>.greeble {
    animation: none;
    color: #2cf877;
}

.handle:active>.greeble {
    animation: 1s back-in-out infinite greeble-pulse;
}

.handle:active>.angle-decorator {
    animation: 0.5s back-in-out infinite jiggle-on-x;
}

.angle-decorator {
    position: absolute;
    top: -210dp;
    left: -360dp;
    width: 400dp;
    height: 400dp;
    transform: rotate(45deg);
}

.section {
    clip: always;
    overflow: hidden scroll;
}
.copy-button {
    cursor: copy;
    position: relative;
}
.copy-button:hover {
    transition: background-color 0.2s;
    background-color: rgba(255, 255, 255, 50);
}
.copy-button:active {
    transform: translate(1px, 1px);
}
.copy-button:active>.tooltip {
    transform: translate(-1px, -1px);
}
.tooltip {
    visibility: hidden;
    text-align: center;
    position: absolute;
    z-index: 1;
    bottom: 100%;
    right: 0;
    opacity: 0;
    transition: opacity 0.1s;
    width: 550dp;
    pointer-events: none;
}

.copy-button:hover>.tooltip {
    visibility: visible;
    opacity: 1;
}

button:active {
    transform: translate(1dp, 1dp)
}
