/* gui_info_rml — bottom unit/selection info bar (v1). LAYOUT ONLY — colour
   via utility/CCG classes in the .rml. ALWAYS laid out: never shown/hidden;
   modes are overlaid panes toggled by data-visible (visibility:hidden — keeps
   the box, no relayout).

   STRUCTURE (owner-directed):
     - the WIDGET has NO background; the bg lives ONLY on `.info-body`.
     - `.info-body` bottom:0, height = bodyH (= order-menu height, data-style) so
       its TOP aligns with the order menu → one clean line across.
     - `.info-tab` is a 232dp bridge (= build-grid width, flush-left) carrying the
       owner; fills from the body's top up to the widget top (140dp). SQUARE.

   POSITION (all hard-coded, owner-directed):
     build grid = left:0 bottom:140dp width:232dp (right edge = 232dp).
     The 232dp tab's right edge aligns with the build grid's right edge (the notch).
     This widget's body is a little wider (300dp); the order menu sits FLUSH against
     its right edge at left:300dp. The info tops out at 140dp → 10dp gap below grid. */

#gui_info_rml-widget {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 300dp;       /* hard-coded: a little wider than the 232dp tab/grid edge; order menu docks flush at left:300dp */
    height: 140dp;      /* up to the build grid's bottom edge; keep == ROOT_H_DP */
    display: block;
    pointer-events: none;
}

/* No background here — transparent wrapper. */
#widget-container {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* The bridge tab — an ANGLED FLAG (build-grid builder-flag motif, Decoration
   Pattern #2). FIXED 24dp tall, BOTTOM-anchored on the order-menu line via
   data-style-bottom="bodyH" so it pokes UP exactly 24dp from the body's top — the
   body stays locked to the order-menu height (the "line across"). The BUILD GRID is
   lowered to rest on this flag's top (= order-menu height + 24dp). 24dp keeps the
   wedge's top:-118dp centering EXACT. WIDTH 300dp = the clip box for the wedge (the
   alignment lever for the diagonal, NOT the child `right`). NO bg / NO radius. */
.info-tab {
    position: absolute;
    left: 0;
    bottom: 108px;       /* fallback ≈ body top; data-style-bottom="bodyH" drives it live */
    width: 300dp;
    height: 24dp;
    display: flex;
    align-items: center;
}
/* FLAG clip box — fills the tab (inset 0); clip:always trims the oversized rotated
   wedge to a clean diagonal (transformed children escape plain overflow — the
   documented force-clip). Absolute + first child → paints BEHIND the label; pe-none. */
.info-flag-clip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    clip: always;
}
/* The wedge: an OVERSIZED square rotated so its edge becomes the flag's diagonal
   RIGHT end after the clip. Fill = bg-primary (.rml), matching the build-grid flag.
   TUNABLES (guess-and-check): transform:rotate() = the ANGLE; `right` = where the
   diagonal falls — in THIS config SMALLER `right` moves the diagonal LEFT (owner-
   confirmed in-game; this is the OPPOSITE of what the build-grid flag's comment
   claims, so trust this one); `top` = -(width - tabH)/2 to vertically centre the
   wedge (tabH ≈ 25dp → -118dp). */
.info-flag {
    position: absolute;
    width: 260dp;
    height: 260dp;
    top: -118dp;
    right: 80dp;
    transform: rotate(-28deg);
}
/* Subtle left→right fade over the flag (build-grid trick); same inset box; pe-none. */
.info-flag-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}
.info-tab-label {
    padding-left: 8dp;
}

/* LOWER INFO SECTION — the ONLY element with a background (ccg.panel.general
   in the .rml). bottom:0; height = bodyH (data-style) = the order-menu height, so
   its TOP sits exactly on the order-menu line ("one line across"). Positioning
   context for the two overlaid panes. */
.info-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* height set via data-style-height="bodyH" */
}

/* Faint decorative tapers (texture) in the body bg — absolute, BEHIND the content
   (first children → DOM paint order), pe-none. A MIRRORED PAIR, each confined to
   its OWN HALF (no overlap): A on the left half, B (mirror) on the right half →
   they sit apart and read as a symmetric pair. Opacity set by the opacity-* utility
   in the .rml. The svg scales to fill its box (viewBox). */
.info-deco {
    position: absolute;
    top: 0;
    height: 100%;
}
.info-deco-a {
    left: 0;
    width: 50%;
}
.info-deco-b {
    right: 0;
    width: 50%;
}

/* Two persistent panes overlaid in the body (absolute → overlap, no summing);
   data-visible flips visibility (paint-only, keeps the box). */
.info-pane {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    padding: 4dp 8dp 4dp 8dp;
}

/* header row inside a pane: name (left) + owner (right) */
.info-headrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 16dp;
    margin-bottom: 2dp;
}

/* single-unit columns */
.col-icon {
    display: block;
    width: 54dp;
    flex-shrink: 0;
}
.unit-icon {
    display: block;
    width: 50dp;
    height: 50dp;
}
.col-main {
    flex: 1;
    display: block;
    margin: 0 8dp;
}
.col-stats {
    display: block;
    width: 120dp;
    flex-shrink: 0;
}

/* multi-select columns */
.col-tally {
    flex: 1;
    display: block;
}
.tally-grid {
    display: block;
}
.col-seltotals {
    display: block;
    width: 160dp;
    flex-shrink: 0;
}

/* ── shared rows (fixed heights) ── */
.info-costrow {
    display: flex;
    justify-content: space-between;
    height: 14dp;
    margin-bottom: 2dp;
}

.info-hp {
    display: flex;
    align-items: center;
    height: 13dp;
    margin-bottom: 2dp;
}
.hp-track {
    display: block;
    position: relative;
    flex: 1;            /* flex-basis:0 → skips content measurement */
    height: 6dp;
    margin-right: 5dp;
}
.hp-fill {
    display: block;
    height: 100%;
    /* width via data-style-width (paint); colour via hpBarClass (.rml) */
}
.hp-val {
    display: block;
}

.info-flow {
    display: flex;
    align-items: center;
    height: 13dp;
}
.info-flow-label {
    display: block;
    width: 44dp;
}
.flow-make {
    display: block;
    margin-right: 6dp;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    height: 13dp;
}

/* multi-select tally: fixed cells; blank ones keep their box (icon src "").
   inline-block flows + wraps; definite size → no measure. */
.info-cell {
    display: inline-block;
    position: relative;
    width: 28dp;
    height: 28dp;
    margin: 1dp;
}
.info-cell-icon {
    display: block;
    width: 26dp;
    height: 26dp;
}
.info-cell-count {
    position: absolute;
    right: 1dp;
    bottom: 0dp;
}
