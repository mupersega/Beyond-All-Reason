/* widget_controller Widget Styles */
#widget_controller-widget {
    /* Standard positioning and sizing - customize as needed */
    display: flex;
    position: absolute;
    left: 50vw;
    top: 50vh;
    margin-left: -150dp;
    margin-top: -30vh;
    width: 300dp;
    height: 60vh;
}

#widget-container {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.debug-btn:hover {
    filter: brightness(1.2);
}

.debug-btn:hover>span {
    transform: translateY(-1dp);
}

/* Draggable handle styles */
.handle {
    height: 100%;
    cursor: move;
    text-align: left;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 5;
    clip: always;
}

.handle>.greeble {
    color: #00000000;
    padding-left: 5dp;
    position: relative;
    top: -15dp;
    font-size: 2.5rem;
}

@keyframes greeble-pulse {
    0% { color: #00000000; }
    50% { color: #fad400; }
    100% { color: #00000000;  }
}

.handle:hover>.greeble {
    animation: none;
    color: #2cf877;
}

.handle:active>.greeble {
    animation: 1s back-in-out infinite greeble-pulse;
}

/* Title bar — right-side clipped angle accent (Approach 2: rotated div).
   Dark wedge on the right so the construction texture stays visible
   behind the title text on the left (visual hierarchy). */
.title-bar-right-wedge {
    position: absolute;
    right: 0dp;
    top: 0dp;
    width: 140dp;
    height: 100%;
    clip: always;
    pointer-events: none;
}

.title-bar-right-wedge-angle {
    position: absolute;
    left: 0dp;
    top: -220dp;
    width: 300dp;
    height: 300dp;
    transform: rotate(72deg);
    z-index: 0;
}

/* Hard-coded height on repeated rows — eliminates content measurement.
   See CLAUDE.md "Performance in a Game Context" rules. */
.widget-entry-row {
    height: 22dp;
}

/* Search input — right-side descending wedge accent, vertically
   flipped version of the title bar's right-side wedge. */
.search-notch {
    position: absolute;
    right: 0dp;
    top: 0dp;
    width: 140dp;
    height: 100%;
    clip: always;
    pointer-events: none;
}

.search-notch-angle {
    position: absolute;
    left: 40dp;
    top: -200dp;
    width: 300dp;
    height: 300dp;
    transform: rotate(-72deg);
    z-index: 0;
}

/* @keyframes placeholder-pulse now lives in components.rcss */

.placeholder-text {
    font-size: 10dp;
    left: 14dp;
    top: 12dp;
    z-index: 1;
    color: #78788c;
    animation: 1.5s linear infinite placeholder-pulse;
}