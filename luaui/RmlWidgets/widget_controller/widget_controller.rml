<rml>
<head>
    <title>widget_controller Widget</title>

    <!-- External stylesheets - order matters for cascading -->
    <link rel="stylesheet" href="../styles.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../rml-utility-classes.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../palette-standard-global.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../components.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../themes/theme-base.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../themes/theme-armada.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../themes/theme-cortex.rcss" type="text/rcss" />
    <link rel="stylesheet" href="../themes/theme-legion.rcss" type="text/rcss" />

    <link rel="stylesheet" href="widget_controller.rcss" type="text/rcss" />

    <style>
        .widget-entry-row:hover .widget-entry-row__text {
            transform: translateX(5dp);
        }
        .widget-entry-row__text {
            transition: transform 0.15s quadratic-out;
        }
        #widget-list-container.loadingWidgets>.widget-entry-row {
            opacity: 0;
        }

        /* Pin button — unpinned state */
        .pin-btn {
            opacity: 0.2;
            transition: opacity 0.2s, transform 0.1s, background-color 0.2s;
        }
        /* Pin button — pinned state */
        .pin-btn.pinned {
            opacity: 1;
        }
        /* Hover: always show clearly */
        .widget-entry-row:hover .pin-btn {
            opacity: 0.7;
        }
        .widget-entry-row:hover .pin-btn.pinned {
            opacity: 1;
        }
        .pin-btn:active {
            transform: scale(0.95);
        }

    </style>
</head>
<body id="widget_controller-widget" class="widget-shadow">
    <div id="widget-container" data-model="widget_controller_model" class="flex flex-col h-full justify-between bg-darkest-alpha hazards-135 clip">
        <div data-attr-class="ccg.sheet.modal.title + ' flex items-center justify-between relative min-h-3'">
            <div class="title-bar-right-wedge">
                <div class="title-bar-right-wedge-angle bg-darkest-alpha"></div>
            </div>
            <span class="z-50 pe-none text-lg pl-2 text-outline-darkest-xl font-bold">
                Widget Controller
            </span>
            <handle move_target="widget_controller-widget" class="handle cursor-move">
                <span class="greeble z-10">.</span>
            </handle>
            <div class="flex gap-1 z-50">
                <button data-if="rmlDebugControls" data-attr-class="ccg.text.warning + ' px-1 debug-btn'" onclick="widget:Reload()">
                    <span>reload</span>
                </button>
                <button data-if="rmlDebugControls" data-attr-class="ccg.text.warning + ' px-1 debug-btn'" onclick="widget:ToggleDebugger()">
                    <span>debug</span>
                </button>
            </div>
        </div>

        <div id="widget-list-container" class="bg-darkest-alpha clip overflow-scroll h-full" data-class-loading="loadingWidgets"
             data-event-mouseout="setHoveredWidget('')">
            <div data-for="widget : visibleWidgets" class="widget-entry-row bg-medium-alpha-hover flex items-center justify-between"
                 data-event-mouseover="setHoveredWidget(widget.desc)">
                <!-- Pin button -->
                <button data-attr-class="'pin-btn cursor-pointer px-1' + (widget.pinned ? ' pinned' : '')"
                        data-event-click="toggleWidgetPin(widget.name)"
                        data-attr-title="'Pin/Unpin widget'">
                    <svg src="../svg/pin_icon.svg" data-attr-class="my.pinSvg"></svg>
                </button>

                <p data-attr-class="(widget.active ? ccg.text.success : ccg.text.danger) + ' widget-entry-row__text px-2 py-1 flex-1 cursor-pointer'"
                    data-event-click="toggleWidget(widget.name)">
                    {{widget.name}}
                </p>
            </div>
        </div>

        <div class="flex items-center min-h-7 px-2 py-1 bg-darker-alpha relative">
            <div class="search-notch">
                <div class="search-notch-angle bg-darkest-alpha"></div>
            </div>
            <span data-visible="filterString == ''" class="placeholder-text pe-none absolute">Search widgets...</span>
            <input id="filter-input" type="text"
                class="flex-1 p-1 text-sm"
                data-value="filterString"
                onchange="widget:UpdateVisibleWidgets(element)"></input>
        </div>

    </div>
</body>
</rml>
