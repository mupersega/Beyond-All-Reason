/* === Font Sizes === */
.text-xxs { font-size: 10dp; }
.text-xs { font-size: 12dp; }
.text-sm { font-size: 14dp; }
.text-base { font-size: 16dp; }
.text-lg { font-size: 18dp; }
.text-xl { font-size: 20dp; }
.text-2xl { font-size: 24dp; }
.text-3xl { font-size: 30dp; }
.text-4xl { font-size: 36dp; }

/* === Font Sizes (rem variants) === */
.text-xxs-rem { font-size: 0.625rem; }
.text-xs-rem { font-size: 0.75rem; }
.text-sm-rem { font-size: 0.875rem; }
.text-base-rem { font-size: 1rem; }
.text-lg-rem { font-size: 1.125rem; }
.text-xl-rem { font-size: 1.25rem; }
.text-2xl-rem { font-size: 1.5rem; }
.text-3xl-rem { font-size: 1.875rem; }
.text-4xl-rem { font-size: 2.25rem; }

/* === Font Weight === */
.font-lightest { font-weight: 100; }
.font-light { font-weight: 200; }
.font-normal { font-weight: 400; }
.font-bold { font-weight: 700; }
.font-extrabold { font-weight: 900; }

/* === Text Align === */
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* === Border === */
/* note that border and border color is not included, it is set instead in the palette files */
.border { border: 1dp; }
.border-0 { border: 1dp transparent; }

.border-bottom { border-bottom: 1dp; }
.border-top { border-top: 1dp; }
.border-left { border-left: 1dp; }
.border-right { border-right: 1dp; }

.border-sm { border-width: 1dp; }
.border-md { border-width: 2dp; }
.border-lg { border-width: 4dp; }

.rounded { border-radius: 4dp; }
.rounded-md { border-radius: 6dp; }
.rounded-lg { border-radius: 8dp; }
.rounded-full { border-radius: 50dp; }

/* === Overflow === */
.clip { clip: always; }

.transition { transition: all 0.2s; }
.transition-bg { transition: background-color 0.2s, color 0.2s; }
.transition-border { transition: border-color 0.2s; }
.transition-fast { transition: all 0.1s; }
.transition-slow { transition: all 0.3s; }

/* === Box Shadow === */
.box-shadow-sm { box-shadow: rgba(0, 0, 0, 100) 0dp 2dp 8dp; }
.box-shadow-md { box-shadow: rgba(0, 0, 0, 120) 0dp 4dp 16dp; }
.box-shadow-lg { box-shadow: rgba(0, 0, 0, 150) 0dp 8dp 32dp; }
.box-shadow-xl { box-shadow: rgba(0, 0, 0, 180) 0dp 16dp 64dp; }
.box-shadow-sm-inset { box-shadow: #000a -2px -2px 5px inset; }
.box-shadow-md-inset { box-shadow: #000a -5px -5px 5px inset; }
.box-shadow-none { box-shadow: none; }

/* === Hover Effects === */
/* General hover utilities - theme-agnostic */
.hover-brighten:hover { filter: brightness(1.2); }
.hover-darken:hover { filter: brightness(0.8); }
.hover-scale:hover { transform: scale(1.05); }
.hover-scale-sm:hover { transform: scale(1.02); }
.hover-scale-lg:hover { transform: scale(1.1); }
.hover-fade:hover { opacity: 0.7; }
.hover-fade-in:hover { opacity: 1.0; }
.hover-shadow:hover { box-shadow: 0dp 4dp 8dp rgba(0, 0, 0, 0.2); }
.hover-shadow-lg:hover { box-shadow: 0dp 8dp 16dp rgba(0, 0, 0, 0.3); }

/* Cursor styles for hovers */
.cursor-pointer { cursor: pointer; }
.cursor-default { cursor: default; }

/* === Z-Index === */
.z-0 { z-index: 0; }
.z-10 { z-index: 10; }
.z-50 { z-index: 50; }
