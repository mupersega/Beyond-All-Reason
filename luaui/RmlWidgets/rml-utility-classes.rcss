/* === Width & Height === */
.w-full { width: 100%; }
.h-full { height: 100%; }

/* Base scale: 4dp unit with golden ratio scaling for larger values */
.w-0 { width: 0dp; }
.w-px { width: 1px; }
.w-dp { width: 1dp; }
.w-0-5 { width: 2dp; }
.w-1 { width: 4dp; }
.w-1-5 { width: 6dp; }
.w-2 { width: 8dp; }
.w-2-5 { width: 10dp; }
.w-3 { width: 12dp; }
