                                            <div data-attr-class="(child.value ? ccg.toggle.success : ccg.toggle.offSuccess)"></div>
                                        </div>
                                        <div data-if="child.type == 'slider'" class="slider-area"><input type="range" data-attr-id="'cfg-' + child.id" data-attr-min="child.min" data-attr-max="child.max" data-attr-step="child.step" data-attr-value="child.value" onchange="widget:OnSlider(element)" /><span data-attr-class="ccg.text.warning + ' slider-value'" data-attr-id="'val-' + child.id">{{child.value}}</span></div>
                                    </div>
                                    <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{child.desc}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- ACCESSIBILITY tab (single flat config)                        -->
        <!-- ============================================================ -->
        <div data-if="activeTab == 'accessibility'" class="options-content">
            <div class="scroll-area">
                <div data-for="section : accessibilitySections">
                    <div data-attr-class="ccg.panel.general + ' p-2 relative panel-with-abs-heading'">
                        <div data-attr-class="my.panelHeading">
                            <div class="panel-heading-angle bg-darkest-alpha radial-focus-start"></div>
                            {{section.heading}}
                        </div>
                        <div data-for="group : section.groups" data-attr-class="my.optionCard + ' mb-1' + (group.parent.disabled ? ' disabled' : '')">
                            <div data-if="group.parent.type == 'bool'" class="setting-row clickable" data-attr-id="'cfg-' + group.parent.id" onclick="widget:OnToggle(element)">
                                <div class="setting-control"><span class="option-label pe-none font-bold">{{group.parent.name}}</span><div data-attr-class="ccg.toggle.panel + ' pe-none'"><div data-attr-class="(group.parent.value ? ccg.toggle.offDanger : ccg.toggle.danger)"></div><div data-attr-class="(group.parent.value ? ccg.toggle.success : ccg.toggle.offSuccess)"></div></div></div>
                                <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{group.parent.desc}}</span>
                            </div>
                            <div data-if="group.parent.type == 'slider'" class="setting-row">
                                <div class="setting-control"><span class="option-label font-bold">{{group.parent.name}}</span><div class="slider-area"><input type="range" data-attr-id="'cfg-' + group.parent.id" data-attr-min="group.parent.min" data-attr-max="group.parent.max" data-attr-step="group.parent.step" data-attr-value="group.parent.value" onchange="widget:OnSlider(element)" /><span data-attr-class="ccg.text.warning + ' slider-value'" data-attr-id="'val-' + group.parent.id">{{group.parent.value}}</span></div></div>
                                <span data-attr-class="ccg.text.description + ' setting-desc'">{{group.parent.desc}}</span>
                            </div>
                            <div data-if="group.parent.type == 'select'" class="setting-row">
                                <div class="setting-control"><span class="option-label font-bold">{{group.parent.name}}</span><select data-attr-id="'cfg-' + group.parent.id" data-value="group.parent.value" onchange="widget:OnSelect(element)"><option data-for="choice : group.parent.selectOptions" data-attr-value="choice.value">{{choice.label}}</option></select></div>
                                <span data-attr-class="ccg.text.description + ' setting-desc'">{{group.parent.desc}}</span>
                            </div>
                            <div data-if="group.parent.type == 'action'" class="setting-row clickable" data-attr-id="'cfg-' + group.parent.id" onclick="widget:OnAction(element)">
                                <div class="setting-control"><span data-attr-class="group.parent.labelClass + ' pe-none'">{{group.parent.name}}</span></div>
                                <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{group.parent.desc}}</span>
                            </div>
                            <div data-if="group.hasChildren" data-attr-class="'option-group-children setting-indent-labels' + (group.parentOff ? ' dimmed' : '')" data-attr-id="'children-' + group.parent.id">
                                <div data-for="child : group.children">
                                    <div data-if="child.type == 'bool'" class="setting-row clickable" data-attr-id="'cfg-' + child.id" onclick="widget:OnToggle(element)">
                                        <div class="setting-control"><span class="option-label pe-none">{{child.name}}</span><div data-attr-class="ccg.toggle.panel + ' pe-none'"><div data-attr-class="(child.value ? ccg.toggle.offDanger : ccg.toggle.danger)"></div><div data-attr-class="(child.value ? ccg.toggle.success : ccg.toggle.offSuccess)"></div></div></div>
                                        <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{child.desc}}</span>
                                    </div>
                                    <div data-if="child.type == 'slider'" class="setting-row">
                                        <div class="setting-control"><span class="option-label">{{child.name}}</span><div class="slider-area"><input type="range" data-attr-id="'cfg-' + child.id" data-attr-min="child.min" data-attr-max="child.max" data-attr-step="child.step" data-attr-value="child.value" onchange="widget:OnSlider(element)" /><span data-attr-class="ccg.text.warning + ' slider-value'" data-attr-id="'val-' + child.id">{{child.value}}</span></div></div>
                                        <span data-attr-class="ccg.text.description + ' setting-desc'">{{child.desc}}</span>
                                    </div>
                                    <div data-if="child.type == 'action'" class="setting-row clickable" data-attr-id="'cfg-' + child.id" onclick="widget:OnAction(element)">
                                        <div class="setting-control"><span class="option-label pe-none">{{child.name}}</span></div>
                                        <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{child.desc}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- DEV tab (single flat config)                                  -->
        <!-- ============================================================ -->
        <div data-if="activeTab == 'dev'" class="options-content">
            <div class="scroll-area">
                <div data-for="section : devSections">
                    <div data-attr-class="ccg.panel.general + ' p-2 relative panel-with-abs-heading'">
                        <div data-attr-class="my.panelHeading">
                            <div class="panel-heading-angle bg-darkest-alpha radial-focus-start"></div>
                            {{section.heading}}
                        </div>
                        <div data-for="group : section.groups" data-attr-class="'option-group' + (group.parent.disabled ? ' disabled' : '')">
                            <div data-attr-class="'setting-row' + (group.parent.type == 'bool' || group.parent.type == 'action' ? ' clickable' : '')" data-attr-id="'cfg-' + group.parent.id" onclick="widget:OnSettingClick(element)">
                                <div class="setting-control">
                                    <span data-attr-class="(group.parent.type == 'action' ? group.parent.labelClass : 'option-label font-bold') + ' pe-none'">{{group.parent.name}}</span>
                                    <div data-if="group.parent.type == 'bool'" data-attr-class="ccg.toggle.panel + ' pe-none'">
                                        <div data-attr-class="(group.parent.value ? ccg.toggle.offDanger : ccg.toggle.danger)"></div>
                                        <div data-attr-class="(group.parent.value ? ccg.toggle.success : ccg.toggle.offSuccess)"></div>
                                    </div>
                                    <div data-if="group.parent.type == 'slider'" class="slider-area"><input type="range" data-attr-id="'cfg-' + group.parent.id" data-attr-min="group.parent.min" data-attr-max="group.parent.max" data-attr-step="group.parent.step" data-attr-value="group.parent.value" onchange="widget:OnSlider(element)" /><span data-attr-class="ccg.text.warning + ' slider-value'" data-attr-id="'val-' + group.parent.id">{{group.parent.value}}</span></div>
                                    <select data-if="group.parent.type == 'select'" data-attr-id="'cfg-' + group.parent.id" data-value="group.parent.value" onchange="widget:OnSelect(element)"><option data-for="choice : group.parent.selectOptions" data-attr-value="choice.value">{{choice.label}}</option></select>
                                </div>
                                <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{group.parent.desc}}</span>
                            </div>
                            <div data-if="group.hasChildren" data-attr-class="'option-group-children setting-indent-labels' + (group.parentOff ? ' dimmed' : '')" data-attr-id="'children-' + group.parent.id">
                                <div data-for="child : group.children" data-attr-class="'setting-row' + (child.type == 'bool' ? ' clickable' : '')" data-attr-id="'cfg-' + child.id" onclick="widget:OnSettingClick(element)">
                                    <div class="setting-control">
                                        <span class="option-label pe-none">{{child.name}}</span>
                                        <div data-if="child.type == 'bool'" data-attr-class="ccg.toggle.panel + ' pe-none'">
                                            <div data-attr-class="(child.value ? ccg.toggle.offDanger : ccg.toggle.danger)"></div>
                                            <div data-attr-class="(child.value ? ccg.toggle.success : ccg.toggle.offSuccess)"></div>
                                        </div>
                                        <div data-if="child.type == 'slider'" class="slider-area"><input type="range" data-attr-id="'cfg-' + child.id" data-attr-min="child.min" data-attr-max="child.max" data-attr-step="child.step" data-attr-value="child.value" onchange="widget:OnSlider(element)" /><span data-attr-class="ccg.text.warning + ' slider-value'" data-attr-id="'val-' + child.id">{{child.value}}</span></div>
                                    </div>
                                    <span data-attr-class="ccg.text.description + ' setting-desc pe-none'">{{child.desc}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        </div><!-- /#drawer-content -->
    </div>
</body>
</rml>
