/* Eating our own dogfood — the stress test is ITSELF an RML widget,
   so every performance sin it commits distorts the numbers we capture.
   Keep this RCSS block ruthlessly cheap per the rules we've codified:
   - No backdrop-filter (catastrophic at full-screen scale)
   - No box-shadow on the root (wasted at full-screen; shadow is the
     single most expensive utility class per isolation tests)
   - No border-radius on the root (invisible at 100vw/100vh edges)
   - Solid bg-color on the container is enough for readability */
#rml_stress_test-widget {
    position: absolute;
    top: 0dp;
    left: 0dp;
    width: 100vw;
    height: 100vh;
    display: flex;
}

.stress-close {
    position: absolute;
    top: 4dp;
    right: 4dp;
    width: 26dp;
    height: 26dp;
    line-height: 26dp;
    text-align: center;
    padding: 0dp;
    background-color: #7a2030cc;
    border-top: 2dp #9a9ab4;
    border-left: 2dp #9a9ab4;
    border-right: 2dp #2a2a3c;
    border-bottom: 2dp #2a2a3c;
    color: #ffe0e0;
    font-size: 18dp;
    font-weight: bold;
    cursor: pointer;
    z-index: 100;
}

.stress-close:hover {
    background-color: #a02040ee;
}

.stress-close:active {
    border-top: 2dp #2a2a3c;
    border-left: 2dp #2a2a3c;
    border-right: 2dp #9a9ab4;
    border-bottom: 2dp #9a9ab4;
}

.stress-peek {
    position: absolute;
    top: 4dp;
    right: 34dp;
    height: 26dp;
    line-height: 26dp;
    text-align: center;
    padding: 0dp 8dp;
    background-color: #304a64;
    border-top: 2dp #9a9ab4;
    border-left: 2dp #9a9ab4;
    border-right: 2dp #2a2a3c;
    border-bottom: 2dp #2a2a3c;
    color: #d0e0ff;
    font-size: 11dp;
    font-weight: bold;
    cursor: pointer;
    z-index: 100;
}

.stress-peek:hover {
    background-color: #4060a0;
}

.stress-peek:active {
    border-top: 2dp #2a2a3c;
    border-left: 2dp #2a2a3c;
    border-right: 2dp #9a9ab4;
    border-bottom: 2dp #9a9ab4;
}

/* Peek mode: hide this widget's own visual (it keeps running, so the
   isolation stays in effect) so you can see what is actually rendering
   behind it. The peek toggle itself is intentionally NOT hidden. */
#widget-container.peeking {
    background-color: transparent;
}

#widget-container.peeking .stress-sidebar,
#widget-container.peeking .stress-stage-wrap,
#widget-container.peeking .stress-close {
    display: none;
}

/* `flex: 1` on the container with two block children (sidebar + stage-wrap)
   is the approved horizontal-split pattern. Definite width on sidebar +
   flex:1 on stage-wrap = single-pass layout. Solid (no alpha) bg-color
   so we don't pay translucency compositing. */
#widget-container {
    display: flex;
    flex: 1;
    background-color: #14141a;
}

/* Block layout for vertical stacking (per rule 1 — no flex-column).
   Scroll container is block, not flex. Definite width so stage-wrap
   gets a determined flex: 1 remainder. */
.stress-sidebar {
    display: block;
    width: 300dp;
    padding: 6dp;
    overflow: hidden scroll;
    border-right: 1dp #303040;
    font-size: 9dp;
}

/* Variant list (CCG / Util / Core). Block, not flex-wrap: a flex-wrap
   row with `flex: 0` (= basis 0%) collapsed buttons to ~0 width, so long
   labels + the result number overlapped illegibly. One full-width row per
   variant is single-pass block layout (cheaper) AND readable.
   288dp = sidebar content width (see .stress-row). */
.stress-ccg-grid {
    display: block;
    width: 288dp;
    margin-bottom: 3dp;
}

/* Variant buttons — highest-count button type. Full-width single line so
   "label [result]" always fits; clip rather than wrap if ever too long. */
.stress-btn-ccg {
    display: block;
    width: 100%;
    height: 16dp;
    line-height: 16dp;
    text-align: left;
    padding: 0dp 5dp;
    margin-bottom: 2dp;
    font-size: 9dp;
    background-color: #2a3040;
    color: #d0d8e0;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
}

.stress-btn-ccg:hover {
    background-color: #3a4054;
}

/* Generic variant list: drop the bevel — beveling ~90 dense rows reads as
   visual noise and adds needless paint in a perf harness. Scoped to the
   grid; the two-class selector outranks .stress-btn so the fixed control
   buttons keep their retro bevel. */
.stress-ccg-grid .stress-btn-ccg {
    border-width: 0;
    font-weight: normal;
}

/* Keep the dense grid flat even on press — a 2dp bevel flickering in
   across ~90 rows on every click is noise + paint. Two-class+pseudo
   specificity outranks .stress-btn:active. */
.stress-ccg-grid .stress-btn-ccg:active {
    border-width: 0;
}

.stress-title {
    display: block;
    font-size: 13dp;
    font-weight: bold;
    margin-bottom: 3dp;
    color: #e0e0f0;
}

.stress-flavour {
    display: block;
    font-size: 8dp;
    line-height: 11dp;
    margin-bottom: 5dp;
    color: #7a7a8c;
}

.stress-info {
    display: block;
    font-size: 9dp;
    margin-bottom: 6dp;
    color: #a0a0b0;
}

.stress-info > div {
    display: block;
    height: 11dp;
    line-height: 11dp;
}

.stress-section {
    display: block;
    margin-top: 5dp;
    margin-bottom: 2dp;
    font-size: 8dp;
    color: #9090a0;
    text-transform: uppercase;
}

/* Hardcoded width (sidebar 300dp minus 2×6dp padding = 288dp) so that
   flex-row children with `flex: 1` resolve in a single pass without the
   engine having to measure/derive anything from the block-flow chain.
   If you change .stress-sidebar width or padding, update this too. */
.stress-row {
    display: flex;
    flex-direction: row;
    width: 288dp;
    margin-bottom: 2dp;
}

/* Solid colors (no alpha) — ~90 buttons × alpha-blend per frame is real
   cost when the container bg is already solid. Same visible result,
   cheaper paint. Two decorators max (bg + border) per our stacking rule. */
.stress-btn {
    display: block;
    flex: 1;
    height: 16dp;
    line-height: 16dp;
    text-align: center;
    padding: 0dp 3dp;
    margin-right: 2dp;
    background-color: #30304a;
    /* Retro raised bevel: light edge top+left, dark edge bottom+right.
       Uniform across all control buttons; -on states invert it (pressed). */
    border-top: 2dp #9a9ab4;
    border-left: 2dp #9a9ab4;
    border-right: 2dp #2a2a3c;
    border-bottom: 2dp #2a2a3c;
    color: #d0d0e0;
    font-size: 9dp;
    font-weight: bold;
    cursor: pointer;
}

.stress-btn:hover {
    background-color: #404064;
}

/* Pressed: invert the bevel (dark top+left, light bottom+right) so the
   button reads physically pushed-in. Only the edge colors swap — widths
   stay 2dp — so there is no reflow on press/release. */
.stress-btn:active {
    border-top: 2dp #2a2a3c;
    border-left: 2dp #2a2a3c;
    border-right: 2dp #9a9ab4;
    border-bottom: 2dp #9a9ab4;
}

.stress-btn-clear {
    height: 18dp;
    line-height: 18dp;
    background-color: #603030;
}

.stress-btn-clear:hover {
    background-color: #804040;
}

.stress-btn-timed {
    height: 20dp;
    line-height: 20dp;
    background-color: #304a30;
    color: #d0e0d0;
    font-weight: bold;
}

.stress-btn-timed:hover {
    background-color: #406440;
}

.stress-btn-timed-on {
    background-color: #60a050;
    /* pressed bevel (inverted): dark top+left, light bottom+right */
    border-top: 2dp #2a2a3c;
    border-left: 2dp #2a2a3c;
    border-right: 2dp #9a9ab4;
    border-bottom: 2dp #9a9ab4;
    color: #ffffe0;
}

.stress-btn-timed-on:hover {
    background-color: #70b060;
}

.stress-btn-suite {
    height: 20dp;
    line-height: 20dp;
    background-color: #304a64;
    color: #d0e0ff;
    font-weight: bold;
}

.stress-btn-suite:hover {
    background-color: #4060a0;
}

.stress-btn-dur {
    background-color: #2a2a3a;
    color: #a0a0b0;
}

.stress-btn-dur:hover {
    background-color: #3a3a4a;
}

.stress-btn-dur-on {
    background-color: #4a6080;
    /* pressed bevel (inverted) — selected duration */
    border-top: 2dp #2a2a3c;
    border-left: 2dp #2a2a3c;
    border-right: 2dp #9a9ab4;
    border-bottom: 2dp #9a9ab4;
    color: #e0e8f0;
    font-weight: bold;
}

/* Tab bar — the active tab's section is mounted via data-if, so
   switching tabs swaps ~80% of the sidebar DOM in/out. Critical for
   keeping the stress test's own overhead down. */
.stress-tab-bar {
    margin-top: 6dp;
    margin-bottom: 4dp;
}

.stress-btn-tab {
    height: 20dp;
    line-height: 20dp;
    background-color: #1e1e28;
    color: #8080a0;
    font-weight: bold;
}

.stress-btn-tab:hover {
    background-color: #2a2a38;
    color: #b0b0c0;
}

.stress-btn-tab-on {
    background-color: #50506a;
    /* pressed bevel (inverted) — active tab */
    border-top: 2dp #2a2a3c;
    border-left: 2dp #2a2a3c;
    border-right: 2dp #9a9ab4;
    border-bottom: 2dp #9a9ab4;
    color: #e0e0f0;
}

/* Gated tab content. data-if REQUIRES display to be defined on the
   element, or the conditional mounting silently breaks. See
   luaui/RmlWidgets/CLAUDE.md Data Binding gotchas.
   Hardcoded width matches sidebar content area so children inherit a
   definite width without needing block-flow derivation. */
.stress-tab-content {
    display: block;
    width: 288dp;
}

.btn-result {
    color: #ffe080;
    font-weight: bold;
    margin-left: 2dp;
}

.stress-btn-copy {
    width: 100%;
    height: 18dp;
    line-height: 18dp;
    background-color: #304a64;
    color: #d0e0ff;
}

.stress-btn-copy:hover {
    background-color: #4060a0;
}

/* Results display rendered into the stage on suite completion */
.stress-results-header {
    display: block;
    font-size: 18dp;
    font-weight: bold;
    color: #ffe080;
    padding: 6dp 0;
    margin-bottom: 2dp;
    border-bottom: 1dp #504a30aa;
}

.stress-results-sub {
    display: block;
    font-size: 10dp;
    color: #a0a0b0;
    margin-bottom: 8dp;
}

.stress-results-row {
    display: block;
    height: 14dp;
    line-height: 14dp;
    font-size: 11dp;
    color: #d0e0f0;
    padding: 1dp 4dp;
}

.stress-btn-danger {
    height: 18dp;
    line-height: 18dp;
    background-color: #7a2030;
    color: #ffd0d0;
}

.stress-btn-danger:hover {
    background-color: #9a3040;
}

.stress-stage-wrap {
    display: block;
    flex: 1;
    overflow: hidden scroll;
    padding: 6dp;
}

.stress-stage {
    display: block;
}

/* Stage content: plain — no styling, definite small height */
.stress-plain-item {
    display: block;
    height: 12dp;
    line-height: 12dp;
    font-size: 9dp;
    color: #b0b0c0;
}

/* Wrapper for grid rows — block layout, cheap */
.stress-nest {
    display: block;
    margin-bottom: 1dp;
}

/* Reactive highlight — toggled each tick in class-mode */
.stress-highlight {
    color: #ffa060;
    background-color: #40302080;
}

/* Anti-pattern container: flex-column, no explicit size.
   Padded + bordered so nesting is VISIBLE in the stage, while still
   forcing content-sized layout (the exponential anti-pattern). */
.stress-flexcol {
    display: flex;
    flex-direction: column;
    padding: 2dp 4dp;
    margin: 1dp 0dp;
    border: 1dp #804040aa;
    background-color: #20141488;
    color: #e08080;
    font-size: 9dp;
}

.stress-hidden {
    display: none;
}
