<rml>
<head>
	<title>Log Viewer (RML)</title>

	<!-- External stylesheets - order matters for cascading -->
	<link rel="stylesheet" href="../styles.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../rml-utility-classes.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../palette-standard-global.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../components.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../themes/theme-base.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../themes/theme-armada.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../themes/theme-cortex.rcss" type="text/rcss" />
	<link rel="stylesheet" href="../themes/theme-legion.rcss" type="text/rcss" />

	<link rel="stylesheet" href="gui_log_viewer_rml.rcss" type="text/rcss" />
</head>
<body id="gui_log_viewer_rml-widget">
	<div id="widget-container" data-model="gui_log_viewer_rml_model" class="flex flex-col h-full">
		<!-- Header bar -->
		<div class="console-header flex items-center justify-between relative">
			<!-- Drag handle: absolute overlay -->
			<handle move_target="gui_log_viewer_rml-widget" class="console-handle"></handle>

			<!-- Title: in flow, above handle -->
			<span class="z-50 pe-none text-sm text-light pl-1">Log Viewer <span id="copied-text" class="text-success">{{copiedAgo}}</span></span>

			<!-- Action buttons: in flow, above handle -->
			<div class="flex items-center gap-0-5 pr-0-5 z-50">
				<button data-attr-class="my.headerBtn + ' bg-dark-alpha-hover text-medium'" data-event-click="scrollToBottom()">
					Bottom
				</button>
				<button data-attr-class="my.headerBtn + ' bg-dark-alpha-hover text-medium'" onclick="widget:CopyAll()">
					<svg src="../svg/copy_icon.svg" data-attr-class="my.svgStyles"></svg>
				</button>
				<button data-attr-class="my.headerBtn + ' bg-dark-alpha-hover text-medium'" data-event-click="clearConsole()">
					<svg src="../svg/bin_icon.svg" data-attr-class="my.svgStyles"></svg>
				</button>
				<button data-attr-class="my.headerBtn + ' bg-danger-hover text-medium'" data-event-click="close()" title="Close console">
					×
				</button>
			</div>
		</div>

		<!-- Scrollable console area -->
		<div id="console-scroll" class="console-scroll" onscroll="widget:OnScroll()">
			<div id="console-text"></div>
			<div id="scroll-anchor"></div>
		</div>

		<!-- Resize handle: bottom-right corner -->
		<handle size_target="gui_log_viewer_rml-widget" class="resize-handle"></handle>
	</div>
</body>
</rml>
